classDiagram
    direction TB
    %% Duration and available_time are in minutes. Time uses validated HH:MM.
    %% Optional fields default to None; optional update arguments leave fields unchanged.
    %% Pet and Task constructors are generated by their dataclasses.

    class Owner {
        +str name
        +float available_time
        +dict preferences
        +List~Pet~ pets
        +Owner(name: str, available_time: float, preferences: Optional~dict~ = None)
        +add_pet(pet: Pet) None
        +update_availability(time: float) None
        +get_all_tasks() List~Task~
    }

    class Pet {
        <<dataclass>>
        +str name
        +str breed
        +int age
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() List~Task~
        +complete_task(task: Task, completion_date: Optional~date~ = None) Optional~Task~
    }

    class Task {
        <<dataclass>>
        +str name
        +float duration
        +str priority
        +str frequency
        +str description
        +bool completed
        +Optional~str~ time
        +Optional~date~ due_date
        -bool _next_occurrence_created
        +update_task(name=None, duration=None, priority=None, frequency=None, description=None, completed=None, time=None, due_date=None) None
        +get_details() str
        +mark_completed() None
        +mark_complete() None
        +mark_incomplete() None
    }

    class Scheduler {
        +Owner owner
        +List~Task~ tasks
        +float available_time
        +Scheduler(owner: Owner)
        +get_tasks() List~Task~
        +sort_tasks() List~Task~
        +sort_by_time() List~Task~
        +filter_tasks(pet_name: Optional~str~ = None, completed: Optional~bool~ = None) List~Task~
        +detect_conflicts() List~str~
        +generate_schedule() List~Task~
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : stores and creates successors
    Scheduler "0..*" --> "1" Owner : retrieves all pet tasks through
    Scheduler ..> Task : sorts, filters, and checks overlaps

    note for Pet "complete_task keeps the original and adds at most one incomplete successor.\nDaily is completion date +1 day; weekly is +7 days. Other frequencies do not recur."
    note for Task "description defaults to empty text; completed defaults to false.\ntime and due_date default to None. The private recurrence flag is not a constructor argument.\nTask completion methods change status only; use Pet.complete_task for recurrence."
    note for Scheduler "tasks and available_time are read-only properties derived from Owner.\nSorting uses clock time only. Conflicts require incomplete tasks with dates, times, and positive durations.\nOvernight overlaps across dates are not detected. generate_schedule raises NotImplementedError."
