classDiagram
    %% Duration and available_time are measured in minutes.
    %% Priority levels are high, medium, and low (not yet validated).
    %% Optional update parameters default to None, meaning leave the field unchanged.
    class Owner {
        +name: str
        +available_time: float
        +preferences: dict
        +pets: list~Pet~
        +add_pet(pet: Pet): void
        +update_availability(time: float): void
    }

    class Pet {
        +name: str
        +breed: str
        +age: int
        +tasks: list~Task~
        +add_task(task: Task): void
        +remove_task(task: Task): void
    }

    class Task {
        +name: str
        +duration: float
        +priority: str
        +frequency: str
        +update_task(name: Optional~str~ = None, duration: Optional~float~ = None, priority: Optional~str~ = None, frequency: Optional~str~ = None): void
        +get_details(): str
    }

    class Scheduler {
        +tasks: list~Task~
        +available_time: float
        +sort_tasks(): list~Task~
        +detect_conflicts(): bool
        +generate_schedule(): list~Task~
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> "0..*" Task : schedules
